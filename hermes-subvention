<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Budget Subvention</title>

<style>
body {
    font-family: Arial, sans-serif;
    margin: 20px;
    background: #eef2f7;
}

h2 {
    text-align: center;
    margin-top: 30px;
    font-size: 1.1em;
    letter-spacing: 2px;
    padding: 10px 0;
    border-radius: 6px;
    color: white;
}

.titre-recettes { background: linear-gradient(90deg, #1b5e20, #43a047); }
.titre-depenses { background: linear-gradient(90deg, #b71c1c, #e53935); }

#rapport {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 3px 15px rgba(0,0,0,0.13);
}

/* ✅ UNE SEULE VERSION PROPRE */
table {
    width: 100%;
    border-collapse: collapse;
    table-layout: auto;
}

th, td {
    border: 1px solid #ccc;
    padding: 5px;
    height: 35px;
}

th {
    font-size: 0.85em;
    text-align: center;
    color: white;
}

#recettes th { background: #1b5e20; }
#depenses th { background: #b71c1c; }

.label {
    font-weight: bold;
}

#recettes .label { background: #e8f5e9; color: #1b5e20; }
#depenses .label { background: #ffebee; color: #b71c1c; }

.separator-top td {
    font-weight: bold;
}

input {
    width: 100%;
    border: none;
    text-align: right;
    outline: none;
    background: transparent;
}

.locked {
    background: #e0e0e0 !important;
    pointer-events: none;
}

button {
    margin: 8px 5px;
    padding: 9px 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
}

.btn-green { background: #2e7d32; color: white; }
.btn-red { background: #c62828; color: white; }
.btn-blue { background: #1565c0; color: white; }
.btn-purple { background: #6a1b9a; color: white; }
</style>

<script defer src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>

<body>

<div id="rapport">

<h2 class="titre-recettes">🟢 RECETTES</h2>

<table id="recettes">
<tr><th></th><th>2025</th><th>2026</th><th>2027</th></tr>

<tr>
<td class="label">Report excédentaire</td>
<td><input id="rep1" type="number"></td>
<td><input id="rep2" class="locked"></td>
<td><input id="rep3" class="locked"></td>
</tr>

<tr><td class="label">État</td><td><input type="number"></td><td><input type="number"></td><td><input type="number"></td></tr>
<tr><td class="label">Région</td><td><input type="number"></td><td><input type="number"></td><td><input type="number"></td></tr>
<tr><td class="label">Département</td><td><input type="number"></td><td><input type="number"></td><td><input type="number"></td></tr>
<tr><td class="label">Commune</td><td><input type="number"></td><td><input type="number"></td><td><input type="number"></td></tr>

<tr class="separator-top">
<td class="label">TOTAL RECETTES</td>
<td><input id="r1" class="locked"></td>
<td><input id="r2" class="locked"></td>
<td><input id="r3" class="locked"></td>
</tr>
</table>

<button class="btn-green" onclick="addRow('recettes')">➕ Ajouter</button>
<button class="btn-blue" onclick="calc()">Calculer</button>

<h2 class="titre-depenses">🔴 DÉPENSES</h2>

<table id="depenses">
<tr><th></th><th>2025</th><th>2026</th><th>2027</th></tr>

<tr><td class="label">Personnel</td><td><input type="number"></td><td><input type="number"></td><td><input type="number"></td></tr>
<tr><td class="label">Gestion</td><td><input type="number"></td><td><input type="number"></td><td><input type="number"></td></tr>

<tr class="separator-top">
<td class="label">TOTAL DÉPENSES</td>
<td><input id="d1" class="locked"></td>
<td><input id="d2" class="locked"></td>
<td><input id="d3" class="locked"></td>
</tr>

<tr class="separator-top">
<td class="label">SOLDE</td>
<td><input id="s1" class="locked"></td>
<td><input id="s2" class="locked"></td>
<td><input id="s3" class="locked"></td>
</tr>

</table>

<button class="btn-red" onclick="addRow('depenses')">➕ Ajouter</button>

<br><br>
<button class="btn-blue" onclick="calc()">Calculer</button>
<button class="btn-purple" onclick="exportPDF()">PDF</button>

</div>

<script>
function addRow(id) {
    const name = prompt("Nom ?");
    if (!name) return;

    const table = document.getElementById(id);
    const index = table.rows.length - 2;

    const row = table.insertRow(index);
    row.innerHTML = `
        <td class="label">${name}</td>
        <td><input type="number"></td>
        <td><input type="number"></td>
        <td><input type="number"></td>
    `;
}

function calc() {
    let r = sum("recettes", ["r1","r2","r3"]);
    let d = sum("depenses", ["d1","d2","d3"]);

    let s1 = r[0] - d[0];
    s1 = isNaN(s1) ? 0 : s1;

    document.getElementById("s1").value = s1.toFixed(2);
    document.getElementById("rep2").value = s1.toFixed(2);

    r = sum("recettes", ["r1","r2","r3"]);
    d = sum("depenses", ["d1","d2","d3"]);

    let s2 = r[1] - d[1];
    s2 = isNaN(s2) ? 0 : s2;

    document.getElementById("s2").value = s2.toFixed(2);
    document.getElementById("rep3").value = s2.toFixed(2);

    r = sum("recettes", ["r1","r2","r3"]);
    d = sum("depenses", ["d1","d2","d3"]);

    let s3 = r[2] - d[2];
    s3 = isNaN(s3) ? 0 : s3;

    document.getElementById("s3").value = s3.toFixed(2);
}

function sum(id, targets) {
    const table = document.getElementById(id);
    let totals = [0,0,0];

    for (let i = 1; i < table.rows.length; i++) {
        let label = table.rows[i].cells[0].innerText;
        if (label.includes("TOTAL") || label.includes("SOLDE")) continue;

        for (let j = 1; j <= 3; j++) {
            let val = parseFloat(table.rows[i].cells[j].querySelector("input")?.value);
            if (!isNaN(val)) totals[j-1] += val;
        }
    }

    targets.forEach((id,i) => {
        document.getElementById(id).value = totals[i].toFixed(2);
    });

    return totals;
}

function exportPDF() {
    const element = document.getElementById("rapport");

    const clone = element.cloneNode(true);
    clone.style.width = "1100px";
    clone.style.position = "absolute";
    clone.style.left = "-9999px";
    document.body.appendChild(clone);

    html2pdf().from(clone).save().then(() => {
        document.body.removeChild(clone);
    });
}
</script>

</body>
</html>
